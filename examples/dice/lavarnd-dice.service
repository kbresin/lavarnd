[Unit]
Description=LavaRnd dice: a Flask demo that rolls dice with LavaRnd
Documentation=https://github.com/kbresin/lavarnd/tree/main/examples/dice
Wants=lavapool.service
After=lavapool.service

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/lavarnd-dice
# app.py lives in /opt/lavarnd-dice; the lavarnd package comes from
# `make install` (/usr/local/lib/lavarnd/python).
Environment=PYTHONPATH=/opt/lavarnd-dice:/usr/local/lib/lavarnd/python
ExecStart=/usr/bin/python3 -m gunicorn --bind 0.0.0.0:8099 --workers 2 --access-logfile - app:app
Restart=on-failure
RestartSec=5

CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
