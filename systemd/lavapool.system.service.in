[Unit]
Description=LavaRnd lavapool random number daemon
Documentation=https://github.com/kbresin/lavarnd

[Service]
Type=simple
# A throwaway unprivileged user; video group membership to open the camera.
DynamicUser=yes
SupplementaryGroups=video
Environment=LD_LIBRARY_PATH=@LIBDIR@
ExecStart=@SBINDIR@/lavapool -p @CFGDIR@/cfg.lavapool
Restart=on-failure
RestartSec=10

# lavapool needs the camera and a localhost TCP port, nothing else.
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
